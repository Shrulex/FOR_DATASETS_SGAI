b_sum + weight * cls_probs\n","        total_weight += weight * len(FLIP_VARIANTS)\n","\n","    return seg_prob_sum / total_weight, cls_prob_sum / total_weight"]},{"cell_type":"code","execution_count":36,"id":"05a96e60","metadata":{"execution":{"iopub.execute_input":"2026-11-11T21:02:48.758861Z","iopub.status.busy":"2026-11-11T21:02:48.758276Z","iopub.status.idle":"2026-11-11T21:02:49.761718Z","shell.execute_reply":"2026-11-11T21:02:49.760686Z"},"papermill":{"duration":1.021925,"end_time":"2026-11-11T21:02:49.763396+00:00","exception":false,"start_time":"2026-11-11T21:02:48.741471+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Ensemble + TTA smoke test OK — torch.Size([1, 4, 128, 800]) torch.Size([1, 4])\n"]}],"source":["_dummy_input = torch.randn(1, 1, HEIGHT, WIDTH, device=DEVICE)\n","_seg_probs, _cls_probs = predict_ensemble_tta(_dummy_input, model_specs, DEVICE)\n","assert _seg_probs.shape == (1, len(CLASSES), HEIGHT, WIDTH), _seg_probs.shape\n","assert _cls_probs.shape == (1, len(CLASSES)), _cls_probs.shape\n","assert torch.all((_seg_probs >= 0) & (_seg_probs <= 1))\n","print(\"Ensemble + TTA smoke test OK —\", _seg_probs.shape, _cls_probs.shape)\n","del _dummy_input, _seg_probs, _cls_probs"]},{"cell_type":"markdown","id":"e06e8bd5","metadata":{"papermill":{"duration":0.01604,"end_time":"2026-11-11T21:02:49.796905+00:00","exception":false,"start_time":"2026-11-11T21:02:49.780865+00:00","status":"completed"},"tags":[]},"source":["## Two-threshold gating: conservative gate, looser mask\n","\n","One threshold doing both jobs (deciding \"is anything here\" and shaping the mask boundary) forces a trade-off neither job needs. Splitting them: a **gate threshold** on the classification head's probability decides whether to predict anything at all for that class; only once gated in does a separate, looser **mask threshold** shape the actual pixels, recovering fuzzy boundaries and small fragments that a single conservative threshold would otherwise cut off.\n","\n","Predictions are cached once over the validation set (ensemble + TTA is expensive to rerun per threshold candidate), then both threshold grids are searched against the cached tensors."]},{"cell_type":"code","execution_count":37,"id":"9f4f050b","metadata":{"execution":{"iopub.execute_input":"2026-11-11T21:02:49.831857Z","iopub.status.busy":"2026-11-11T21:02:49.8315Z","iopub.status.idle":"2026-11-11T21:02:49.850998Z","shell.execute_reply":"2026-11-11T21:02:49.850153Z"},"papermill":{"duration":0.039396,"end_time":"2026-11-11T21:02:49.852582+00:00","exception":false,"start_time":"2026-11-11T21:02:49.813186+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def cache_ensemble_predictions(model_specs, loader, device):\n","    cached = []\n","    with torch.inference_mode():\n","        for images, masks in tqdm(loader, desc=\"Caching ensemble predictions\"):\n","            images = images.to(device, non_blocking=True)\n","            seg_probs, cls_probs = predict_ensemble_tta(images, model_specs, device)\n","            cached.append((seg_probs.half().cpu(), cls_probs.half().cpu(), masks.half().cpu()))\n","    return cached\n","\n","\n","def select_mask_thresholds(cached_predictions, thresholds, classes, height, width):\n","    num_t, num_c = len(thresholds), len(classes)\n","    pixels_per_pair = height * width\n","    pos_dice_sum = np.zeros((num_t, num_c))\n","    fp_pixels_sum = np.zeros((num_t, num_c))\n","    empty_correct_sum = np.zeros((num_t, num_c))\n","    pos_counts = np.zeros(num_c, dtype=np.int64)\n","    empty_counts = np.zeros(num_c, dtype=np.int64)\n","    threshold_tensor = torch.as_tensor(thresholds).view(-1, 1, 1, 1, 1)\n","\n","    for seg_probs, _, masks in cached_predictions:\n","        seg_probs, masks = seg_probs.float(), masks.float()\n","        targets = masks >= 0.5\n","        target_counts = targets.sum(dim=(-2, -1))\n","        positive = target_counts > 0\n","        empty = ~positive\n","        pos_counts += positive.sum(dim=0).numpy()\n","        empty_counts += empty.sum(dim=0).numpy()\n","\n","        predictions = seg_probs.unsqueeze(0) >= threshold_tensor\n","        predicted_counts = predictions.sum(dim=(-2, -1))\n","        intersections = (predictions & targets.unsqueeze(0)).sum(dim=(-2, -1))\n","        pair_dice = 2.0 * intersections.float() / (predicted_counts + target_counts.unsqueeze(0)).clamp_min(1)\n","\n","        pos_dice_sum += (pair_dice * positive.unsqueeze(0)).sum(dim=1).numpy()\n","        fp_pixels_sum += (predicted_counts * empty.unsqueeze(0)).sum(dim=1).numpy()\n","        empty_correct_sum += ((predicted_counts == 0) & empty.unsqueeze(0)).sum(dim=1).numpy()\n","\n","    contributions = np.zeros((num_t, num_c))\n","    for c in range(num_c):\n","        contributions[:, c] = (\n","            0.70 * pos_dice_sum[:, c] / pos_counts[c]\n","            - 0.20 * fp_pixels_sum[:, c] / (empty_counts[c] * pixels_per_pair)\n","            + 0.10 * empty_correct_sum[:, c] / empty_counts[c]\n","        )\n","    selected = contributions.argmax(axis=0)\n","    return {classes[c]: float(thresholds[int(selected[c])]) for c in range(num_c)}, contributions\n","\n","\n","def select_gate_thresholds(cached_predictions, mask_thresholds, gate_grid, classes, height, width):\n","    num_g, num_c = len(gate_grid), len(classes)\n","    pixels_per_pair = height * width\n","    pos_dice_sum = np.zeros((num_g, num_c))\n","    fp_pixels_sum = np.zeros((num_g, num_c))\n","    empty_correct_sum = np.zeros((num_g, num_c))\n","    pos_counts = np.zeros(num_c, dtype=np.int64)\n","    empty_counts = np.zeros(num_c, dtype=np.int64)\n","    mask_threshold_tensor = torch.as_tensor([mask_thresholds[c] for c in classes]).view(1, num_c, 1, 1)\n","    gate_tensor = torch.as_tensor(gate_grid).view(-1, 1, 1)\n","\n","    for seg_probs, cls_probs, masks in cached_predictions:\n","        seg_probs, cls_probs, masks = seg_probs.float(), cls_probs.float(), masks.float()\n","        targets = masks >= 0.5\n","        target_counts = targets.sum(dim=(-2, -1))\n","        positive = target_counts > 0\n","        empty = ~positive\n","        pos_counts += positive.sum(dim=0).numpy()\n","        empty_counts += empty.sum(dim=0).numpy()\n","\n","        base_pred = seg_probs >= mask_threshold_tensor\n","        gate_pass = cls_probs.unsqueeze(0) >= gate_tensor\n","        preds = base_pred.unsqueeze(0) & gate_pass.unsqueeze(-1).unsqueeze(-1)\n","\n","        predicted_counts = preds.sum(dim=(-2, -1))\n","        intersections = (preds & targets.unsqueeze(0)).sum(dim=(-2, -1))\n","        pair_dice = 2.0 * intersections.float() / (predicted_counts + target_counts.unsqueeze(0)).clamp_min(1)\n","\n","        pos_dice_sum += (pair_dice * positive.unsqueeze(0)).sum(dim=1).numpy()\n","        fp_pixels_sum += (predicted_counts * empty.unsqueeze(0)).sum(dim=1).numpy()\n","        empty_correct_sum += ((predicted_counts == 0) & empty.unsqueeze(0)).sum(dim=1).numpy()\n","\n","    contributions = np.zeros((num_g, num_c))\n","    for c in range(num_c):\n","        contributions[:, c] = (\n","            0.70 * pos_dice_sum[:, c] / pos_counts[c]\n","            - 0.20 * fp_pixels_sum[:, c] / (empty_counts[c] * pixels_per_pair)\n","            + 0.10 * empty_correct_sum[:, c] / empty_counts[c]\n","        )\n","    selected = contributions.argmax(axis=0)\n","    return {classes[c]: float(gate_grid[int(selected[c])]) for c in range(num_c)}, contributions"]},{"cell_type":"code","execution_count":38,"id":"52eac41d","metadata":{"execution":{"iopub.execute_input":"2026-11-11T21:02:49.887042Z","iopub.status.busy":"2026-11-11T21:02:49.886354Z","iopub.status.idle":"2026-11-11T21:10:29.824124Z","shell.execute_reply":"2026-11-11T21:10:29.822591Z"},"papermill":{"duration":459.974454,"end_time":"2026-11-11T21:10:29.84316+00:00","exception":true,"start_time":"2026-11-11T21:02:49.868706+00:00","status":"failed"},"tags":[]},"outputs":[{"data":{"app