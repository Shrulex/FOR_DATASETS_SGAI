 not raw Dice@0.5), same W&B logging shape, same EMA handling. At the end of training the function compares the final raw weights against the EMA-smoothed weights on validation and keeps whichever scores higher, since training has been visibly noisy epoch-to-epoch (see the V5 defect_a curve in the writeup above)."]},{"cell_type":"code","execution_count":20,"id":"d1383ca4","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:16.930552Z","iopub.status.busy":"2026-11-11T18:23:16.930109Z","iopub.status.idle":"2026-11-11T18:23:16.935723Z","shell.execute_reply":"2026-11-11T18:23:16.934992Z"},"papermill":{"duration":0.014064,"end_time":"2026-11-11T18:23:16.937421+00:00","exception":false,"start_time":"2026-11-11T18:23:16.923357+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class EMA:\n","    def __init__(self, model, decay=0.999):\n","        self.decay = decay\n","        self.shadow = {k: v.detach().clone() for k, v in model.state_dict().items()}\n","\n","    def update(self, model):\n","        with torch.no_grad():\n","            for k, v in model.state_dict().items():\n","                if v.dtype.is_floating_point:\n","                    self.shadow[k].mul_(self.decay).add_(v.detach(), alpha=1 - self.decay)\n","                else:\n","                    self.shadow[k] = v.detach().clone()"]},{"cell_type":"code","execution_count":21,"id":"cd463118","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:16.949747Z","iopub.status.busy":"2026-11-11T18:23:16.949288Z","iopub.status.idle":"2026-11-11T18:23:16.964134Z","shell.execute_reply":"2026-11-11T18:23:16.963368Z"},"papermill":{"duration":0.022961,"end_time":"2026-11-11T18:23:16.965757+00:00","exception":false,"start_time":"2026-11-11T18:23:16.942796+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def run_validation(model, forward_single, val_loader, device, state_dict=None):\n","    original_state = None\n","    if state_dict is not None:\n","        original_state = copy.deepcopy(model.state_dict())\n","        model.load_state_dict(state_dict, strict=True)\n","    model.eval()\n","\n","    def fwd(images):\n","        output = forward_single(model, images)\n","        return output[0] if isinstance(output, tuple) else output\n","\n","    results, contributions = evaluate_weighted_metric(fwd, val_loader, THRESHOLD_GRID, CLASSES, HEIGHT, WIDTH, device)\n","\n","    if original_state is not None:\n","        model.load_state_dict(original_state, strict=True)\n","    model.train()\n","    return results, contributions\n","\n","\n","def train_model(\n","    model, forward_single, train_loader, val_loader, optimizer, scheduler,\n","    epochs, device, checkpoint_path, run_name, has_aux_head=False,\n","    cls_pos_weight=None, aux_loss_weight=0.3, use_ema=True, ema_decay=0.999,\n","    grad_accum_steps=1, run_config=None,\n","):\n","    wandb.init(project=WANDB_PROJECT, name=run_name, config=run_config or {}, reinit=True)\n","\n","    model.to(device)\n","    scaler = torch.amp.GradScaler(\"cuda\", enabled=(device.type == \"cuda\"))\n","    ema = EMA(model, decay=ema_decay) if use_ema else None\n","\n","    best_score = -1.0\n","    best_state = None\n","    history = []\n","\n","    for epoch in range(1, epochs + 1):\n","        model.train()\n","        running_loss = 0.0\n","        batches = 0\n","        optimizer.zero_grad(set_to_none=True)\n","\n","        for step, (images, masks) in enumerate(tqdm(train_loader, desc=f\"{run_name} | epoch {epoch}/{epochs}\")):\n","            images = images.to(device, non_blocking=True)\n","            masks = masks.to(device, non_blocking=True)\n","\n","            with torch.autocast(device_type=device.type, dtype=torch.float16, enabled=(device.type == \"cuda\")):\n","                output = forward_single(model, images)\n","                if has_aux_head:\n","                    seg_logits, cls_logits = output\n","                    loss = segmentation_loss(seg_logits, masks) + aux_loss_weight * classification_loss(\n","                        cls_logits, masks, cls_pos_weight\n","                    )\n","                else:\n","                    seg_logits = output\n","                    loss = segmentation_loss(seg_logits, masks)\n","                loss_to_backward = loss / grad_accum_steps\n","\n","            scaler.scale(loss_to_backward).backward()\n","\n","            is_last_in_accum = (step + 1) % grad_accum_steps == 0\n","            is_last_batch = (step + 1) == len(train_loader)\n","            if is_last_in_accum or is_last_batch:\n","                scaler.step(optimizer)\n","                scaler.update()\n","                optimizer.zero_grad(set_to_none=True)\n","                if scheduler is not None:\n","                    scheduler.step()\n","                if ema is not None:\n","                    ema.update(model)\n","\n","            running_loss += float(loss.item())\n","            batches += 1\n","\n","        train_loss = running_loss / max(batches, 1)\n","        results, _ = run_validation(model, forward_single, val_loader, device)\n","        class_scores = {r[\"class\"]: r[\"weighted_score\"] for r in results}\n","        mean_score = float(np.mean(list(class_scores.values())))\n","\n","        log_payload = {\"epoch\": epoch, \"train_loss\": train_loss, \"val_weighted_score\": mean_score}\n","        log_payload.update({f\"{k}_weighted_score\": v for k, v in class_scores.items()})\n","        wandb.log(log_payload)\n","        history.append(log_payload)\n","        print(f\"{run_name} | epoch {epoch}/{epochs} | train_loss {train_loss:.5f} | val_weighted_score {mean_score:.5f}\")\n","\n","        if mean_score > best_score:\n","            best_score = mean_score\n","            best_state = copy.deepcopy(model.state_dict())\n","\n","    final_best_state = best_state\n","    final_best_score = best_score\n","\n","    if ema is not None:\n","        ema_results, _ = run_validation(model, forward_single, val_loader, device, state_dict=ema.shadow)\n","        ema_score = float(np.mean([r[\"weighted_score\"] for r in ema_results]))\n","        print(f\"{run_name} | best raw score {best_score:.5f} | EMA score {ema_score:.5f}\")\n","        wandb.log({\"ema_val_weighted_score\": ema_score})\n","        if ema_score > final_best_score:\n","            final_best_state = copy.deepcopy(ema.shadow)\n","            final_best_score = ema_score\n","\n","    torch.save({\n","        \"model_state_dict\": final_best_state,\n","        \"weighted_score\": final_best_score,\n","        \"classes\": CLASSES, \"height\": HEIGHT, \"width\": WIDTH,\n","        \"run_name\": run_name,\n","    }, checkpoint_path)\n","    wandb.finish()\n","\n","    return pd.DataFrame(history), final_best_score"]},{"cell_type":"markdown","id":"f3993224","metadata":{"papermill":{"duration":0.005603,"end_time":"2026-11-11T18:23:16.977433+00:00","exception":false,"start_time":"2026-11-11T18:23:16.97183+00:00","status":"completed"},"tags":[]},"source":["## Model A — ResNet34-UNet, built from scratch\n","\n","`encoder_weights=None` — no ImageNet transfer, fully random initialization, trained only on this dataset. This satisfies the \"one model built from scratch\" requirement directly, and gives a clean, directly-comparable baseline against Model B (identical architecture, pretrained) for the report's transfer-learning discussion.\n","\n","`aux_params` adds a built-in image-level classification head (documented `segmentation_models_pytorch` feature) — `model(x)` returns `(seg_logits, cls_logits)`."]},{"cell_type":"code","execution_count":22,"id":"f188a611","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:16.990351Z","iopub.status.busy":"2026-11-11T18:23:16.989949Z","iopub.status.idle":"2026-11-11T18:23:16.994893Z","shell.execute_reply":"2026-11-11T18:23:16.994126Z"},"papermill":{"duration":0.013298,"end_time":"2026-11-11T18:23:16.996512+00:00","exception":false,"start_time":"2026-11-11T18:23:16.983214+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def build_unet(encoder_name, encoder_weights, num_classes):\n","    return smp.Unet(\n","        encoder_name=encoder_name,\n","        encoder_weights=encoder_weights,\n","        in_channels=1,\n","        classes=num_classes,\n","        activation=None,\n","        aux_params=dict(pooling=\"avg\", dropout=0.3, activation=None, classes=num_classes),\n","    )\n","\n","\n","def unet_forward(model, images):\n","    seg_logits, cls_logits = model(images)\n","    return seg_logits, cls_logits"]},{"cell_type":"code","execution_count":23,"id":"fd6a0ac3","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:17.008931Z","iopub.status.busy":"2026-11-11T18:23:17.008478Z","iopub.status.idle":"2026-11-11T18:23:18.17612Z","shell.execute_reply":"2026-11-11T18:23:18.175093Z"},"papermill":{"duration":1.175995,"end_time":"2026-11-11T18:23:18.177937+00:00","exception":false,"start_time":"2026-11-11T18:23:17.001942+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Unet + aux head smoke test OK — torch.Size([2, 4, 128, 800]) torch.Size([2, 4])\n"]}],"source":["_dummy_model = build_unet(\"resnet34\", None, len(CLASSES))\n","_dummy_input = torch.randn(2, 1, HEIGHT, WIDTH)\n","_seg_out, _cls_out = unet_forward(_dummy_model, _dummy_input)\n","assert _seg_out.shape == (2, len(CLASSES), HEIGHT, WIDTH), _seg_out.shape\n","assert _cls_out.shape == (2, len(CLASSES)), _cls_out.shape\n","print(\"Unet + aux head smoke test OK —\", _seg_out.shape, _cls_out.shape)\n","del _dummy_model, _dummy_input, _seg_out, _cls_out"]},{"cell_type":"code","execution_count":24,"id":"b86725e6","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:18.190679Z","iopub.status.busy":"2026-11-11T18:23:18.190132Z","iopub.status.idle":"2026-11-11T19:15:52.939598Z","shell.execute_reply":"2026-11-11T19:15:52.938877Z"},"papermill":{"duration":3154.757899,"end_time":