                  stack[class_idx] = decode_rle(row[\"mask_rle\"], (height, width))\n","        lookup[image_id] = stack\n","    return lookup\n","\n","\n","mask_lookup = build_mask_lookup(train_df_raw, image_ids, CLASSES, HEIGHT, WIDTH)"]},{"cell_type":"code","execution_count":11,"id":"f2491c80","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:13.878819Z","iopub.status.busy":"2026-11-11T18:23:13.878383Z","iopub.status.idle":"2026-11-11T18:23:14.612143Z","shell.execute_reply":"2026-11-11T18:23:14.611249Z"},"papermill":{"duration":0.742001,"end_time":"2026-11-11T18:23:14.61404+00:00","exception":false,"start_time":"2026-11-11T18:23:13.872039+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Train images: 9114 | Val images: 2279\n","label_combo\n","clean                         4413\n","defect_c                      2484\n","defect_d                       657\n","defect_a                       481\n","defect_c+defect_d              478\n","defect_a+defect_c              172\n","defect_b                       121\n","defect_a+defect_d              109\n","defect_a+defect_c+defect_d      70\n","defect_b+defect_c               54\n","Name: count, dtype: int64\n"]}],"source":["def label_signature(image_id, lookup, classes):\n","    mask = lookup[image_id]\n","    present = [classes[i] for i in range(len(classes)) if mask[i].any()]\n","    return \"clean\" if len(present) == 0 else \"+\".join(present)\n","\n","\n","labels_df = pd.DataFrame({\"image_id\": image_ids})\n","labels_df[\"label_combo\"] = labels_df[\"image_id\"].apply(lambda x: label_signature(x, mask_lookup, CLASSES))\n","\n","rare_combo_counts = labels_df[\"label_combo\"].value_counts()\n","labels_df[\"stratify_key\"] = labels_df[\"label_combo\"].where(\n","    labels_df[\"label_combo\"].map(rare_combo_counts) >= 2, \"rare_other\"\n",")\n","\n","train_df, val_df = train_test_split(\n","    labels_df, test_size=0.20, random_state=SEED, stratify=labels_df[\"stratify_key\"]\n",")\n","train_df = train_df.reset_index(drop=True)\n","val_df = val_df.reset_index(drop=True)\n","\n","print(\"Train images:\", len(train_df), \"| Val images:\", len(val_df))\n","print(train_df[\"label_combo\"].value_counts().head(10))"]},{"cell_type":"markdown","id":"15c8afb6","metadata":{"papermill":{"duration":0.005654,"end_time":"2026-11-11T18:23:14.625172+00:00","exception":false,"start_time":"2026-11-11T18:23:14.619518+00:00","status":"completed"},"tags":[]},"source":["## Dataset, augmentation, weighted sampler\n","\n","Augmentation set, in order: both flip axes, brightness/contrast jitter, light gaussian noise, a small translation (shift, not crop — keeps the full strip visible), and coarse dropout (cutout) applied to the image only. Cutout forces the model to not over-rely on any single patch of the strip rather than removing label information, so it's left off the mask. This is a heavier augmentation set than before, directly in response to wanting more regularization — applied in raw [0,1] pixel space, before per-image z-score normalization, so brightness/cutout operate on actual pixel intensities rather than already-normalized values.\n","\n","The weighted sampler oversamples images containing rare classes (`defect_a`, `defect_b`), capped at 3x to avoid overfitting on a handful of repeated images."]},{"cell_type":"code","execution_count":12,"id":"350358f7","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:14.637618Z","iopub.status.busy":"2026-11-11T18:23:14.637089Z","iopub.status.idle":"2026-11-11T18:23:14.653549Z","shell.execute_reply":"2026-11-11T18:23:14.652904Z"},"papermill":{"duration":0.024723,"end_time":"2026-11-11T18:23:14.655202+00:00","exception":false,"start_time":"2026-11-11T18:23:14.630479+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def random_shift(image, mask, max_shift_frac=0.04):\n","    height, width = image.shape\n","    shift_y = random.randint(-int(height * max_shift_frac), int(height * max_shift_frac))\n","    shift_x = random.randint(-int(width * max_shift_frac), int(width * max_shift_frac))\n","    if shift_y == 0 and shift_x == 0:\n","        return image, mask\n","    image = np.roll(image, shift=(shift_y, shift_x), axis=(0, 1))\n","    mask = np.roll(mask, shift=(shift_y, shift_x), axis=(1, 2))\n","    return image, mask\n","\n","\n","def cutout(image, max_patches=2, patch_frac=0.08):\n","    height, width = image.shape\n","    image = image.copy()\n","    for _ in range(random.randint(1, max_patches)):\n","        patch_h = max(1, int(height * patch_frac * random.uniform(0.5, 1.5)))\n","        patch_w = max(1, int(width * patch_frac * random.uniform(0.5, 1.5)))\n","        top = random.randint(0, max(height - patch_h, 0))\n","        left = random.randint(0, max(width - patch_w, 0))\n","        image[top:top + patch_h, left:left + patch_w] = float(image.mean())\n","    return image\n","\n","\n","class SurfaceDefectDataset(Dataset):\n","    def __init__(self, dataframe, image_dir, mask_lookup, classes, height, width, augment=False):\n","        self.df = dataframe.reset_index(drop=True)\n","        self.image_dir = Path(image_dir)\n","        self.mask_lookup = mask_lookup\n","        self.classes = classes\n","        self.height = height\n","        self.width = width\n","        self.augment = augment\n","\n","    def __len__(self):\n","        return len(self.df)\n","\n","    def __getitem__(self, idx):\n","        image_id = str(self.df.iloc[idx][\"image_id\"])\n","        image_path = self.image_dir / f\"{image_id}.jpg\"\n","\n","        image = Image.open(image_path).convert(\"L\")\n","        image = image.resize((self.width, self.height), Image.Resampling.BILINEAR)\n","        image = np.asarray(image, dtype=np.float32) / 255.0\n","\n","        mask = self.mask_lookup[image_id].astype(np.float32).copy()\n","\n","        if self.augment:\n","            if random.random() < 0.5:\n","                image = np.flip(image, axis=1)\n","                mask = np.flip(mask, axis=2)\n","            if random.random() < 0.5:\n","                image = np.flip(image, axis=0)\n","                mask = np.flip(mask, axis=1)\n","            if random.random() < 0.3:\n","                image, mask = random_shift(image, mask)\n","            if random.random() < 0.5:\n","                gain = random.uniform(0.85, 1.15)\n","                bias = random.uniform(-0.08, 0.08)\n","                image = np.clip(image * gain + bias, 0.0, 1.0)\n","            if random.random() < 0.3:\n","                noise = np.random.normal(0.0, 0.02, size=image.shape).astype(np.float32)\n","                image = np.clip(image + noise, 0.0, 1.0)\n","            if random.random() < 0.25:\n","                image = cutout(image)\n","\n","        mean = float(image.mean())\n","        std = max(float(image.std()), 0.05)\n","        image = (image - mean) / std\n","\n","        image_tensor = torch.from_numpy(np.ascontiguousarray(image)).unsqueeze(0).float()\n","        mask_tensor = torch.from_numpy(np.ascontiguousarray(mask)).float()\n","        return image_tensor, mask_tensor\n","\n","\n","class TestDefectDataset(Dataset):\n","    def __init__(self, image_ids, image_dir, height, width):\n","        self.image_ids = list(image_ids)\n","        self.image_dir = Path(image_dir)\n","        self.height = height\n","        self.width = width\n","\n","    def __len__(self):\n","        return len(self.image_ids)\n","\n","    def __getitem__(self, idx):\n","        image_id = self.image_ids[idx]\n","        image_path = self.image_dir / f\"{image_id}.jpg\"\n","\n","        image = Image.open(image_path).convert(\"L\")\n","        image = image.resize((self.width, self.height), Image.Resampling.BILINEAR)\n","        image = np.asarray(image, dtype=np.float32) / 255.0\n","\n","        mean = float(image.mean())\n","        std = max(float(image.std()), 0.05)\n","        image = (image - mean) / std\n","\n","        image_tensor = torch.from_numpy(np.ascontiguousarray(image)).unsqueeze(0).float()\n","        return image_id, image_tensor"]},{"cell_type":"code","execution_count":13,"id":"233e72c8","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:14.667097Z","iopub.status.busy":"2026-11-11T18:23:14.666694Z","iopub.status.idle":"2026-11-11T18:23:14.719606Z","shell.execute_reply":"2026-11-11T18:23:14.718842Z"},"papermill":{"duration":0.060802,"end_time":"2026-11-11T18:23:14.721388+00:00","exception":false,"start_time":"2026-11-11T18:23:14.660586+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Dataset smoke test OK — torch.Size([1, 128, 800]) torch.Size([4, 128, 800])\n"]}],"source":["_sample_ds = SurfaceDefectDataset(train_df.head(4), TRAIN_IMAGE_DIR, mask_lookup, CLASSES, HEIGHT, WIDTH, augment=True)\n","_img, _msk = _sample_ds[0]\n","assert _img.shape == (1, HEIGHT, WIDTH), _img.shape\n","assert _msk.shape == (len(CLASSES), HEIGHT, WIDTH), _msk.shape\n","print(\"Dataset smoke test OK —\", _img.shape, _msk.shape)"]},{"cell_type":"code","execution_count":14,"id":"9b71f2e3","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:14.734248Z","iopub.status.busy":"2026-11-11T18:23:14.733853Z","iopub.status.idle":"2026-11-11T18:23:15.850135Z","shell.execute_reply":"2026-11-11T18:23:15.849418Z"},"papermill":{"duration":1.124978,"end_time":"2026-11-11T18:23:15.852316+00:00","exception":false,"start_time":"2026-11-11T18:23:14.727338+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Train positive-image counts per class: {'defect_a': 865, 'defect_b': 250, 'defect_c': 3280, 'defect_d': 1365}\n"]}],"source":["def build_class_image_counts(image_ids, mask_lookup, classes):\n","    counts = np.zeros(len(classes), dtype=np.int64)\n","    for image_id in image_ids:\n","        present = mask_lookup[image_id].any(axis=(1, 2))\n","        counts += present.astype(np.int64)\n","    return counts\n","\n","\n","def build_sample_weights(image_ids, mask_lookup, classes, class_image_counts, cap=3.0):\n","    weights = []\n","    n = len(image_ids)\n","    for image_id in image_ids:\n","        present_idx = np.where(mask_lookup[image_id].any(axis=(1, 2)))[0]\n","        if len(present_idx) == 0:\n","            weights.append(1.0)\n","        else:\n","            candidate_weights = [\n","                min(cap, np.sqrt(n / max(int(class_image_counts[c]), 1))) for c in present_idx\n","            ]\n","            weights.append(max(candidate_weights))\n","    return torch.as_tensor(weights, dtype=torch.double)\n","\n","\n","train_class_counts = build_class_image_counts(train_df[\"image_id\"].astype(str), mask_lookup, CLASSES)\n","print(\"Train positive-image counts per class:\", dict(zip(CLASSES, train_class_counts.tolist())))\n","\n","sample_weights = build_sample_weights(train_df[\"image_id\"].astype(str), mask_lookup, CLASSES, train_class_counts)\n","train_sampler = torch.utils.data.WeightedRandomSampler(sample_weights, len(sample_weights), replacement=True)"]},{"cell_type":"code","execution_count":15,"id":"0863433d","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:15.866204Z","iopub.status.busy":"2026-11-11T18:23:15.865921Z","iopub.status.idle":"2026-11-11T18:23:15.871676Z","shell.execute_reply":"2026-11-11T18:23:15.870728Z"},"papermill":{"duration":0.014719,"end_time":"2026-11-11T18:23:15.873278+00:00","exception":false,"start_time":"2026-11-11T18:23:15.858559+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def build_loaders(batch_size, num_workers=2):\n","    train_dataset = SurfaceDefectDataset(train_df, TRAIN_IMAGE_DIR, mask_lookup, CLASSES, HEIGHT, WIDTH, augment=True)\n","    val_dataset = SurfaceDefectDataset(val_df, TRAIN_IMAGE_DIR, mask_lookup, CLASSES, HEIGHT, WIDTH, augment=False)\n","\n","    train_loader = DataLoader(\n","        train_dataset, batch_size=batch_size, sampler=train_sampler,\n","        num_workers=num_workers, pin_memory=True, drop_last=True,\n","    )\n","    val_loader = DataLoader(\n","        val_dataset, batch_size=batch_size, shuffle=False,\n","        num_workers=num_workers, pin_memory=True,\n","    )\n","    return train_loader, val_loader"]},{"cell_type":"markdown","id":"35aa059a","metadata":{"papermill":{"duration":0.005411,"end_time":"2026-11-11T18:23:15.884025+00:00","exception":false,"start_time":"2026-11-11T18:23:15.878614+00:00","status":"completed"},"tags":[]},"source":["## Losses\n","\n","Hybrid BCE + Focal Tversky for segmentation (BCE anchors probability calibration, Tversky handles the class-imbalance-aware overlap objective — see the writeup above for why pure Tversky caused the threshold-saturation bug in the V3 run). A separate weighted BCE for the auxiliary image-level classification head."]},{"cell_type":"code","execution_count":16,"id":"04418323","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:15.89674Z","iopub.status.busy":"2026-11-11T18:23:15.896335Z","iopub.status.idle":"2026-11-11T18:23:16.180413Z","shell.execute_reply":"2026-11-11T18:23:16.179628Z"},"papermill":{"duration":0.292741,"end_time":"2026-11-11T18:23:16.182342+00:00","exception":false,"start_time":"2026-11-11T18:23:15.889601+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Classification pos_weight per class: [9.536416053771973, 35.45600128173828, 1.7786585092544556, 5.6769232749938965]\n"]}],"source":["def focal_tversky_loss(logits, targets, alpha=0.3, beta=0.7, gamma=0.75, eps=1e-6):\n","    probabilities = torch.sigmoid(logits.float())\n","    targets = targets.float()\n","    dims = (0, 2, 3)\n","    tp = (probabilities * targets).sum(dim=dims)\n","    fp = (probabilities * (1 - targets)).sum(dim=dims)\n","    fn = ((1 - probabilities) * targets).sum(dim=dims)\n","    tversky = (tp + eps) / (tp + alpha * fp + beta * fn + eps)\n","    return ((1 - tversky).clamp_min(0) ** gamma).mean()\n","\n","\n","def segmentation_loss(logits, targets):\n","    bce = nn.functional.binary_cross_entropy_with_logits(logits.float(), targets.float())\n","    tversky = focal_tversky_loss(logits, targets)\n","    return 0.5 * bce + 0.5 * tversky\n","\n","\n","def classification_loss(cls_logits, masks, pos_weight):\n","    image_labels = (masks.sum(dim=(-2, -1)) > 0).float()\n","    return nn.functional.binary_cross_entropy_with_logits(cls_logits.float(), image_labels, pos_weight=pos_weight)\n","\n","\n","CLASS_POS_WEIGHT = torch.as_tensor(\n","    [(len(train_df) - c) / max(c, 1) for c in train_class_counts], dtype=torch.float32, device=DEVICE\n",")\n","print(\"Classification pos_weight per class:\", CLASS_POS_WEIGHT.tolist())"]},{"cell_type":"code","execution_count":17,"id":"9de2029e","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:16.19568Z","iopub.status.busy":"2026-11-11T18:23:16.194906Z","iopub.status.idle":"2026-11-11T18:23:16.29843Z","shell.execute_reply":"2026-11-11T18:23:16.297407Z"},"papermill":{"duration":0.11172,"end_time":"2026-11-11T18:23:16.300135+00:00","exception":false,"start_time":"2026-11-11T18:23:16.188415+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Segmentation loss smoke test OK — 0.8073322772979736\n","Classification loss smoke test OK — 8.962870597839355\n"]}],"source":["_dummy_logits = torch.randn(4, len(CLASSES), 16, 16)\n","_dummy_targets = (torch.rand(4, len(CLASSES), 16, 16) > 0.9).float()\n","_loss_value = segmentation_loss(_dummy_logits, _dummy_targets)\n","assert torch.isfinite(_loss_value)\n","print(\"Segmentation loss smoke test OK —\", float(_loss_value))\n","\n","_dummy_cls_logits = torch.randn(4, len(CLASSES))\n","_cls_loss_value = classification_loss(_dummy_cls_logits, _dummy_targets, CLASS_POS_WEIGHT.cpu())\n","assert torch.isfinite(_cls_loss_value)\n","print(\"Classification loss smoke test OK —\", float(_cls_loss_value))"]},{"cell_type":"markdown","id":"4af54041","metadata":{"papermill":{"duration":0.006895,"end_time":"2026-11-11T18:23:16.314905+00:00","exception":false,"start_time":"2026-11-11T18:23:16.30801+00:00","status":"completed"},"tags":[]},"source":["## The corrected weighted competition metric\n","\n","This is the single function every model's threshold selection and checkpointing goes through — defined once here so the per-class normalization bug from the V4/V5 run (dividing by the global pair-count total instead of each class's own count) can't silently reappear in a copy-pasted cell. `forward_fn` takes a batch of images and returns segmentation logits at full resolution — each model below supplies its own."]},{"cell_type":"code","execution_count":18,"id":"33611d94","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:23:16.328656Z","iopub.status.busy":"2026-11-11T18:23:16.328334Z","iopub.status.idle":"2026-11-11T18:23:16.342972Z","shell.execute_reply":"2026-11-11T18:23:16.341984Z"},"papermill":{"duration":0.023906,"end_time":"2026-11-11T18:23:16.34459+00:00","exception":false,"start_time":"2026-11-11T18:23:16.320684+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["THRESHOLD_GRID = np.array([\n","    0.005, 0.01, 0.02, 0.03, 0.05, 0.075, 0.10, 0.125, 0.15, 0.20,\n","    0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.60, 0.70, 0.80, 0.90, 0.95, 0.98, 0.99\n","], dtype=np.float32)\n","\n","\n","def evaluate_weighted_metric(forward_fn, loader, thresholds, classes, height, width, device):\n","    num_t = len(thresholds)\n","    num_c = len(classes)\n","    pixels_per_pair = height * width\n","\n","    pos_dice_sum = np.zeros((num_t, num_c))\n","    fp_pixels_sum = np.zeros((num_t, num_c))\n","    empty_correct_sum = np.zeros((num_t, num_c))\n","    pos_counts = np.zeros(num_c, dtype=np.int64)\n","    empty_counts = np.zeros(num_c, dtype=np.int64)\n","\n","    threshold_tensor = torch.as_tensor(thresholds, device=device).view(-1, 1, 1, 1, 1)\n","\n","    with torch.inference_mode():\n","        for images, masks in loader:\n","            images = images.to(device, non_blocking=True)\n","            masks = masks.to(device, non_blocking=True)\n","\n","            with torch.autocast(device_type=device.type, dtype=torch.float16, enabled=(device.type == \"cuda\")):\n","                logits = forward_fn(images)\n","            probabilities = torch.sigmoid(logits.float())\n","\n","            targets = masks >= 0.5\n","            target_counts = targets.sum(dim=(-2, -1))\n","            positive = target_counts > 0\n","            empty = ~positive\n","            pos_counts += positive.sum(dim=0).cpu().numpy()\n","            empty_counts += empty.sum(dim=0).cpu().numpy()\n","\n","            predictions = probabilities.unsqueeze(0) >= threshold_tensor\n","            predicted_counts = predictions.sum(dim=(-2, -1))\n","            intersections = (predictions & targets.unsqueeze(0)).sum(dim=(-2, -1))\n","            pair_dice = 2.0 * intersections.float() / (predicted_counts + target_counts.unsqueeze(0)).clamp_min(1)\n","\n","            pos_dice_sum += (pair_dice * positive.unsqueeze(0)).sum(dim=1).cpu().numpy()\n","            fp_pixels_sum += (predicted_counts * empty.unsqueeze(0)).sum(dim=1).cpu().numpy()\n","            empty_correct_sum += ((predicted_counts == 0) & empty.unsqueeze(0)).sum(dim=1).cpu().numpy()\n","\n","    contributions = np.zeros((num_t, num_c))\n","    for c in range(num_c):\n","        contributions[:, c] = (\n","            0.70 * pos_dice_sum[:, c] / pos_counts[c]\n","            - 0.20 * fp_pixels_sum[:, c] / (empty_counts[c] * pixels_per_pair)\n","            + 0.10 * empty_correct_sum[:, c] / empty_counts[c]\n","        )\n","\n","    selected = contributions.argmax(axis=0)\n","    results = []\n","    for c, name in enumerate(classes):\n","        idx = int(selected[c])\n","        results.append({\n","            \"class\": name,\n","            \"threshold\": float(thresholds[idx]),\n","            \"p