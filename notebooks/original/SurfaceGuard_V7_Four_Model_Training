def encode_rle(mask):\n","    pixels = mask.flatten(order=\"F\")\n","    pixels = np.concatenate([[0], pixels, [0]])\n","    runs = np.where(pixels[1:] != pixels[:-1])[0] + 1\n","    runs[1::2] -= runs[0::2]\n","    if len(runs) == 0:\n","        return \"\"\n","    return \" \".join(str(x) for x in runs)"]},{"cell_type":"code","execution_count":8,"id":"b92c490d","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:22:56.760566Z","iopub.status.busy":"2026-11-11T18:22:56.760332Z","iopub.status.idle":"2026-11-11T18:22:56.769514Z","shell.execute_reply":"2026-11-11T18:22:56.768806Z"},"papermill":{"duration":0.016923,"end_time":"2026-11-11T18:22:56.771251+00:00","exception":false,"start_time":"2026-11-11T18:22:56.754328+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["RLE round-trip OK\n"]}],"source":["_self_test_mask = np.zeros((HEIGHT, WIDTH), dtype=np.uint8)\n","_self_test_mask[10:15, 20:25] = 1\n","_self_test_mask[100:103, 700:720] = 1\n","_rle = encode_rle(_self_test_mask)\n","_decoded = decode_rle(_rle, (HEIGHT, WIDTH))\n","assert np.array_equal(_self_test_mask, _decoded), \"RLE round-trip failed\"\n","print(\"RLE round-trip OK\")"]},{"cell_type":"code","execution_count":9,"id":"10929a73","metadata":{"execution":{"iopub.execute_input":"2026-11-11T18:22:56.782952Z","iopub.status.busy":"2026-11-11T18:22:56.78264Z","iopub.status.idle":"2026-11-11T18:22:57.078761Z","shell.execute_reply":"2026-11-11T18:22:57.077744Z"},"papermill":{"duration":0.304399,"end_time":"2026-11-11T18:22:57.080789+00:00","exception":false,"start_time":"2026-11-11T18:22:56.77639+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Unique training images: 11393\n","     image_id defect_type                                           mask_rle  \\\n","0  4S22I7SA34    defect_a  7255 6 7377 12 7505 12 7633 12 7762 11 7890 11...   \n","1  4S22I7SA34    defect_b                                     